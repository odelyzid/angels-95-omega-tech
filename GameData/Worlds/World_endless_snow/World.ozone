Mesh.Static Models/rocks/SM_RP_Rock_8m_5.glb 500 -350 0 -30 scale=1.3 tex=oztex/props/rocks_T_RP_Rocks_0_4K.png
Mesh.Static Models/rocks/SM_RP_Rock_4m_3.glb 470 380 0 0 scale=1.0 tex=oztex/props/rocks_T_RP_Rocks_1_2K.png
Mesh.Static Models/rocks/SM_RP_Rock_4m_4.glb 460 -100 0 90 scale=1.0 tex=oztex/props/rocks_T_RP_Rocks_2_2K.png
Mesh.Static Models/rocks/SM_RP_Rock_4m_5.glb 475 -400 0 180 scale=1.0 tex=oztex/props/rocks_T_RP_Rocks_0_2K.png
# Bottom-edge cliff massing
Mesh.Static Models/rocks/SM_RP_Rock_8m_4K.glb -300 -500 0 10 scale=1.2 tex=oztex/props/rocks_T_RP_Rocks_0_4K.png
Mesh.Static Models/rocks/SM_RP_Rock_8m_0.glb 0 -510 0 0 scale=1.3 tex=oztex/props/rocks_T_RP_Rocks_0_4K.png
Mesh.Static Models/rocks/SM_RP_Rock_8m_3.glb 300 -500 0 -20 scale=1.2 tex=oztex/props/rocks_T_RP_Rocks_0_4K.png
Mesh.Static Models/rocks/SM_RP_Rock_4m_6.glb -150 -480 0 45 scale=1.0 tex=oztex/props/rocks_T_RP_Rocks_1_2K.png
Mesh.Static Models/rocks/SM_RP_Rock_4m_7.glb 150 -485 0 120 scale=1.0 tex=oztex/props/rocks_T_RP_Rocks_2_2K.png
# Brush snowdrifts pushed against the perimeter rocks
add box -500 200 1.5 60 3 12 0 texPath=oztex/tileset/02_floor_snow_a3_32.png
add box -500 -300 1.5 60 3 12 0 texPath=oztex/tileset/02_floor_snow_a3_32.png
add box 500 0 1.5 60 3 12 0 texPath=oztex/tileset/02_floor_snow_a3_32.png
add box 0 -510 1.5 12 3 60 0 texPath=oztex/tileset/02_floor_snow_a3_32.png

