OZONE
# ==============================================================================
# World_endless_snow — snowbound industrial complex
# ==============================================================================
# OZONE Z-up: x=east, y=north, z=up.
# Canvas is an eight-by-eight grid, one cell = one hundred and twenty-eight
# world units. The map is centred on the origin, so extents are roughly
# x -512..+512 and y -512..+512.
#
# Scale conventions used in this file:
#   * Player collision is three units tall with a two-unit eye height.
#   * kStepHeight is one unit: every stair tread rises exactly one unit.
#   * Shared ground plane sits at z=0 (snow).
#   * Concrete facility pads sit one-tenth unit higher, top z=0.1.
#   * Road strips sit at z=0.05, halfway between snow and concrete.
#   * Interior ceilings / roof undersides start no lower than z=4.0.
#
# Layout zones (see the header table in the design brief for grid ranges):
#   Z1  North Radar Tower        (NW corner)
#   Z2  Maintenance Hangars      (northwest-central)
#   Z3  Fuel Storage Tanks       (northeast-central)
#   Z4  South Radar Tower        (NE corner)
#   Z5  Primary Refinery Block   (map centre, largest mass)
#   Z6  Power Plant              (east of refinery)
#   Z7  Security Outpost         (east-central)
#   Z8  Rail Yard Terminal       (east-central)
#   Z8b Rail Yard Track Field    (southeast)
#   Z9  Administration Building  (west-central)
#   Z10 Data Console Lobby       (south-central, spawn)
#   Z11 East Radar Tower         (SW corner, sector codename)
#   Z12 West Radar Tower         (SE corner, sector codename)
#
# The four radar towers ring the central refinery and act as the orientation
# system through the heavy snow fog.
# ==============================================================================

# ==============================================================================
# Sky zone — explicit name so the sibling .ozls skyzone script resolves.
# ==============================================================================
zone sky -600 -600 -50 600 600 300 1 name=endless_snow_sky

# ==============================================================================
# Level metadata and weather.
# Heavy snow, low visibility, cold overcast sky.
# ==============================================================================
levelinfo 0 8 5 0 10 50 0 GameData/Global/sky/sky_day.dds GameData/Global/sky/sky_day.dds
particles snow 120 2.0 220 230 235 0.3 0.2

# ==============================================================================
# Global ground plane — snow, covers the whole play area plus a margin.
# ==============================================================================
add box 0 0 -0.55 1200 1.1 1200 0 texPath=oztex/tileset/01_floor_snow_a2_32.png

# ==============================================================================
# Backdrop walls — fake-backdrop planes that frame the fog horizon.
# flags=8 disables depth writing so the skybox shows through.
#
# Panels are 1u thick and 14u tall (z spans 0..14), segmented into 4 runs per
# side. This matches Dust_Ravine's backdrop convention. Do NOT scale these up to
# match the ground plane: because depth writes are disabled they draw over the
# scene, so an over-tall panel reads as a solid roof blanketing the map from any
# elevated camera rather than as a distant horizon.
# ==============================================================================
# North wall panels (thin in Y, facing south)
add box -450 560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box -150 560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box 150 560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box 450 560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
# South wall panels (thin in Y, facing north)
add box -450 -560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box -150 -560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box 150 -560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box 450 -560 7 45 14 1 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
# East wall panels (thin in X, facing west)
add box 560 -450 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box 560 -150 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box 560 150 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box 560 450 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
# West wall panels (thin in X, facing east)
add box -560 -450 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box -560 -150 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box -560 150 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png
add box -560 450 7 1 14 45 0 flags=8 texScaleU=10 texScaleV=4 texPath=oztex/tileset/00_sky_snow_a1_32.png

# ==============================================================================
# PERIMETER — raised ice and rock terrain.
# Left, right, and bottom edges get 8m and 4m rocks plus brush snowdrifts.
# The north edge is left more open for the approach from the tundra.
# ==============================================================================
# Left-edge cliff massing
Mesh.Static Models/rocks/SM_RP_Rock_8m_0.glb -500 200 0 45 scale=1.2 tex=oztex/props/rocks_T_RP_Rocks_0_4K.png
Mesh.Static Models/rocks/SM_RP_Rock_8m_1.glb -490 -50 0 120 scale=1.1 tex=oztex/props/rocks_T_RP_Rocks_0_4K.png
