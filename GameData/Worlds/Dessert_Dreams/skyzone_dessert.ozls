entity "zone_sky_0" : skyzone {
    fog_color = (0.8, 0.6, 0.4)
    fog_density = 0.002
    ambient_light = (0.5, 0.4, 0.3)
    skybox = "GameData/Worlds/Dessert_Dreams/Models/Skybox.png"
    actions {
        on_enter {
            set_fog 0.8 0.6 0.4 0.002
            set_ambient 0.5 0.4 0.3
            set_skybox "GameData/Worlds/Dessert_Dreams/Models/Skybox.png"
            say "Entered Dessert_Dreams — hot desert atmosphere active"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "Exited Dessert_Dreams sky zone"
        }
    }
}
