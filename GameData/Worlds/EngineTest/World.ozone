OZONE
# EngineTest — Primary test world for CSG brushes + skybox + outdoor area
# OZONE Z-up convention: x=east, y=north, z=up
# Scaled up for player dimensions (Height=10, Width=2)

# ==============================================================================
# Sky zone — expanded to cover both indoor and outdoor areas
# ==============================================================================
zone sky -80 -80 -30 80 80 80

# ==============================================================================
# Ground plane (everything sits on) — extended south for outdoor area
# ==============================================================================
add box 10 -10 -0.5 60 0.5 85 0           # main ground (rooms area)
add box 20 -68 -0.5 46 0.5 48 0 5          # outdoor ground (texSlot=5 grass)

# ==============================================================================
# ROOM 1 (top-left, connects to Room2 via CorridorA, Room4 via CorridorD)
# ==============================================================================
add box 0 10 -0.25 15 0.5 15 0           # floor
add box 0 17.75 5 15 10 0.5 0            # north wall
add box -5 2.25 5 5 10 0.5 0             # south wall left
add box 5 2.25 5 5 10 0.5 0              # south wall right
add box 7.75 15 5 0.5 10 5 0             # east wall upper
add box 7.75 5 5 0.5 10 5 0              # east wall lower
add box -7.75 10 5 0.5 10 15 0           # west wall
add cyl 0 10 5 0.6 0.6 10 16 0           # column

# ==============================================================================
# ROOM 2 (top-right, connects to Room1 via CorridorA, Room3 via CorridorB)
# ==============================================================================
add box 20 10 -0.25 15 0.5 15 0
add box 20 17.75 5 15 10 0.5 0
add box 15 2.25 5 5 10 0.5 0
add box 25 2.25 5 5 10 0.5 0
add box 27.75 10 5 0.5 10 15 0
add box 12.25 15 5 0.5 10 5 0
add box 12.25 5 5 0.5 10 5 0
add cyl 20 10 5 0.6 0.6 10 16 0

# ==============================================================================
# ROOM 4 (bottom-left, connects to Room1 via CorridorD, Room3 via CorridorC)
# ==============================================================================
add box 0 -10 -0.25 15 0.5 15 0
add box -5 -2.75 5 5 10 0.5 0
add box 5 -2.75 5 5 10 0.5 0
add box 0 -17.75 5 15 10 0.5 0
add box 7.75 -5 5 0.5 10 5 0
add box 7.75 -15 5 0.5 10 5 0
add box -7.75 -10 5 0.5 10 15 0
add cyl 0 -10 5 0.6 0.6 10 16 0

# ==============================================================================
# ROOM 3 (bottom-right hub, connects to Room2, Room4, LargeRoom)
# ==============================================================================
add box 20 -10 -0.25 15 0.5 15 0
add box 15 -2.75 5 5 10 0.5 0
add box 25 -2.75 5 5 10 0.5 0
add box 15 -17.75 5 5 10 0.5 0
add box 25 -17.75 5 5 10 0.5 0
add box 27.75 -10 5 0.5 10 15 0
add box 12.25 -5 5 0.5 10 5 0
add box 12.25 -15 5 0.5 10 5 0
add cyl 20 -10 5 0.6 0.6 10 16 0

# ==============================================================================
# LARGE ROOM (connects to Room3 via CorridorE, Outdoor via CorridorF)
# ==============================================================================
add box 20 -38 -0.25 23 0.5 23 0
add box 13 -26.75 5 9 10 0.5 0
add box 27 -26.75 5 9 10 0.5 0
add box 12 -49.75 5 9 10 0.5 0           # south wall LEFT  (x=7.5..16.5, gap 16.5..23.5)
add box 28 -49.75 5 9 10 0.5 0           # south wall RIGHT (x=23.5..32.5)
add box 31.75 -38 5 0.5 10 23 0
add box 8.25 -38 5 0.5 10 23 0
add cyl 12 -30 5 0.6 0.6 10 16 0
add cyl 28 -30 5 0.6 0.6 10 16 0
add cyl 12 -46 5 0.6 0.6 10 16 0
add cyl 28 -46 5 0.6 0.6 10 16 0

# Two pillars flanking the exit to outdoor area (floor top at Y=0 → center=5)
add cyl 17 -49.75 5 0.4 0.4 10 16 0
add cyl 23 -49.75 5 0.4 0.4 10 16 0

# Large Room ceiling with atrium (open center gap)
add box 12.25 -38 10 7.5 0.5 23 0        # left ceiling slab
add box 27.75 -38 10 7.5 0.5 23 0        # right ceiling slab

# ==============================================================================
# Corridors connecting rooms
# ==============================================================================
add box 10 10 -0.25 5 0.5 5 0            # Corridor A (Room1-Room2)
add box 10 12.75 5 5 10 0.5 0
add box 10 7.25 5 5 10 0.5 0

add box 20 0 -0.25 5 0.5 5 0             # Corridor B (Room2-Room3)
add box 22.75 0 5 0.5 10 5 0
add box 17.25 0 5 0.5 10 5 0

add box 10 -10 -0.25 5 0.5 5 0           # Corridor C (Room4-Room3)
add box 10 -7.25 5 5 10 0.5 0
add box 10 -12.75 5 5 10 0.5 0

add box 0 0 -0.25 5 0.5 5 0              # Corridor D (Room1-Room4)
add box 2.75 0 5 0.5 10 5 0
add box -2.75 0 5 0.5 10 5 0

add box 20 -22 -0.25 5 0.5 9 0           # Corridor E (Room3-LargeRoom)
add box 22.75 -22 5 0.5 10 9 0
add box 17.25 -22 5 0.5 10 9 0

# ==============================================================================
# OUTDOOR AREA (south of LargeRoom) — open sky, pillars, garden walls
# ==============================================================================
# Decorative low walls framing the space (snapped to Z=-0.5 ground, h=1 → center Z=0)
add box 12 -62 0 12 1 18 0              # low garden wall left
add box 28 -62 0 12 1 18 0              # low garden wall right
add box 12 -75 0 12 1 8 0               # far wall left
add box 28 -75 0 12 1 8 0               # far wall right

# Tall pillars (snapped to outdoor ground Z=-0.5, height=12 → center Z=5.5)
add cyl 12 -55 5.5 0.5 0.5 12 16 0
add cyl 28 -55 5.5 0.5 0.5 12 16 0
add cyl 12 -72 5.5 0.5 0.5 12 16 0
add cyl 28 -72 5.5 0.5 0.5 12 16 0

# Threshold floor patch under arch pillars (fills gap between large room and walkway)
add box 20 -49.75 -0.25 12 0.5 1 0       # arch threshold floor

# Walkway from large room exit to the outdoor area
add box 20 -55 -0.25 6 0.5 10 0          # walkway floor

# Walkway walls (short, like a covered passage)
add box 16 -55 5 2 10 7 0                 # walkway left wall
add box 24 -55 5 2 10 7 0                 # walkway right wall

# Walkway ceiling (partial — front half open to sky)
add box 20 -52 7 8 0.5 4 0                # ceiling over rear half of walkway

# Archway frame (thin walls flanking the exit from large room)
add box 14 -49.75 5 2 10 0.5 0           # left arch pillar
add box 26 -49.75 5 2 10 0.5 0           # right arch pillar

# ==============================================================================
# Player start
# ==============================================================================
playerstart 0 8 0 0

# ==============================================================================
# Portal to Dust_Ravine (level-to-level connection test)
# OZONE Z-up: bounds min/max in Z-up coords, then spawn point IN TARGET WORLD
# (Dust_Ravine coords: open sand east of its west-approach rocks, eye height 2)
# ==============================================================================
portal Dust_Ravine -3 14 0 3 20 8 -66 8 2 bidir

# Level metadata + ambient particles (test)
levelinfo SINGLEPLAYER 8 5 0 0 50 0
particles RAIN 100 18 0.4 0.5 0.85 -2 1

# ==============================================================================
# NPC spawns
# ==============================================================================
npc Walker 10 10 0
npc Walker 0 -10 0
npc Skaarj 20 -10 0
npc Brute 20 -38 0
npc Floater 28 -38 0
npc Walker 32 -45 0

# ==============================================================================
# Pickup nodes — one per room with matching colored lights
# ==============================================================================
# Room 1 (lobby, top-left) — Health Vial + red light
pickup HealthVial 0 10 3
# Room 2 (top-right) — Mana Vial + blue light
pickup ManaVial 20 10 3
# Room 3 (bottom-right hub) — Key + orange light
pickup Key 20 -10 3
# Room 4 (bottom-left) — Coin + yellow light
pickup Coin 0 -10 3
# Large Room — Energy Crystal + Powerup
pickup EnergyCrystal 20 -38 3
pickup Powerup 28 -38 3

# ==============================================================================
# Zone volumes for testing zone physics/audio
# ==============================================================================
# Room 4 — ZONE_WATER (flooded room, bottom-left)
zone water -7.5 -17.5 0 7.5 -2.5 10

# Corridor D — ZONE_LADDER (vertical climb test, center cross)
zone ladder -2.5 2.5 0 2.5 -2.5 10

# Large Room — ZONE_REVERB (echo test, bottom-right large area)
zone reverb 0 -46 0 40 -30 10

# Room 2 — ZONE_GAMEPLAY_SOUND (music/sound emitter test, top-right)
zone sound 12.5 2.5 0 27.5 17.5 10

# ==============================================================================
# Lights — matching pickup colors per room
# ==============================================================================
# Sun (directional) — ambient fill from above
light directional -50 -50 80 200 210 255 0.3

# Room 1 — HEALTH VIAL → RED point light
light point 0 10 4 255 40 40 0.9 30

# Room 2 — MANA VIAL → BLUE point light
light point 20 10 4 60 100 255 0.9 30

# Room 3 — KEY → ORANGE point light
light point 20 -10 4 255 160 40 0.9 30

# Room 4 — COIN → YELLOW point light
light point 0 -10 4 255 220 50 0.9 30

# Large Room — two cool white lights under ceiling slabs
light point 12.25 -30 9 200 210 255 0.6 30
light point 27.75 -46 9 200 210 255 0.6 30

# Corridor E — light strip
light point 20 -22 3 180 200 255 0.4 20

# ==============================================================================
# Outdoor area lights — warm sunlight + point lights
# ==============================================================================
# Pillar lights — warm glow around each pillar
light point 12 -55 4 255 180 80 0.8 25 1    # water/fire effect
light point 28 -55 4 255 180 80 0.8 25 1
light point 12 -72 4 255 180 80 0.6 20
light point 28 -72 4 255 180 80 0.6 20

# Garden area — ambient colored lights
light point 20 -62 2 100 200 255 0.4 30
light point 20 -75 2 255 200 100 0.3 25
