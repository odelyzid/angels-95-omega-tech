entity "Player" : upgrade {
    // Player character model used to render players in the world. STUB: static
    // mesh only (no skeletal clips yet) converted from the psx character pack.
    mesh = "GameData/Global/Player/Character_Killer_01.glb"
    texture = "GameData/Global/Player/Character_Killer_01.png"
    mesh_type = "static"
    // Base walk-speed multiplier (sprint/crouch scale this at runtime).
    movement_speed = 1.0
    stats {
        health = 100
        max_health = 100
        mana = 0
        max_mana = 100
        psychic_energy = 0
        max_psychic_energy = 100
        level = 1
        xp = 0
        xp_to_next = 100
    }
}
