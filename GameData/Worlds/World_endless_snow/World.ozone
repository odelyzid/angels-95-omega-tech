# ==============================================================================
# INDUSTRIAL BUILDING GLBs
# Source assets are Y-up, baked at 100x scale, so scale=0.01 brings them to
# OZONE game units. Each building uses a shared atlas; tex= override is not
# expected to remap sub-meshes, so they render with their embedded material.
# These five whole-building models replace the hand-authored brush shells in
# zones Z2, Z6, Z7, Z8, and Z9.
#
# DO NOT add scale= here. Each GLB bakes scale=100 plus a Y-up -> Z-up node
# rotation (and a translation that centres the mesh), so it already arrives at
# world scale: Building_A's 0.12u mesh becomes a 12x6x12u building. Adding
# scale=0.01 cancels that 100x bake and renders a 0.12u (knee-high) box.
# tools/worldcheck.cpp flags any mesh whose scaled span drops below 1u.
#
# The loader maps the authored third arg onto engine up, so the third value is
# the vertical offset. Each model's node bake leaves its base below the origin
# (Building_A spans z -28..-16 pre-placement), so the third arg lifts it onto
# the concrete pads rather than burying it.
# ==============================================================================
# Z9 — Administration Building (12x6x12u)
Mesh.Static Models/industrial/Building_A.glb -263 3 28.1 0
# Z6 — Power Plant (15x15x15u)
Mesh.Static Models/industrial/Building_B.glb 282 -8 12.1 90
# Z2 — Maintenance Hangars (12x6x12u)
Mesh.Static Models/industrial/Building_C.glb -134 3 15.1 0
# Z8 — Rail Yard Terminal (15x30x15u)
Mesh.Static Models/industrial/Building_D.glb 316 -15 28.1 0
# Z7 — Security Outpost (12x7x20u)
Mesh.Static Models/industrial/Building_E.glb 341 -3 2.1 -90

# ==============================================================================
# PARTICLE EMITTERS
# Steam/exhaust from stacks, plus a few drifting snow gusts.
# ==============================================================================
# Refinery pipe-stack steam
ParticleEmitter smoke -90 25 40 20 120 1.5 12 3 3 220 220 230 200 200 210 -0.5 8 0 0 1 0
ParticleEmitter smoke -90 75 40 20 120 1.5 12 3 3 220 220 230 200 200 210 -0.5 8 0 0 1 0
ParticleEmitter smoke -40 50 40 20 120 1.5 12 3 3 220 220 230 200 200 210 -0.5 8 0 0 1 0
# Power plant smokestacks
ParticleEmitter smoke 230 130 42 30 180 2.0 15 4 4 200 200 210 180 180 190 -0.8 10 0.2 0 1 0
ParticleEmitter smoke 290 140 42 30 180 2.0 15 4 4 200 200 210 180 180 190 -0.8 10 0.2 0 1 0
ParticleEmitter smoke 250 30 42 30 180 2.0 15 4 4 200 200 210 180 180 190 -0.8 10 0.2 0 1 0
# Snow gusts in open areas
ParticleEmitter snow -300 150 4 60 300 2.5 20 2 2 240 245 255 230 235 245 0.1 40 0.5 0.2 0 0
ParticleEmitter snow 350 -350 4 60 300 2.5 20 2 2 240 245 255 230 235 245 0.1 40 0.5 0.2 0 0

# ==============================================================================
# WIND ZONE — gentle ambient drift across the whole complex.
# ==============================================================================
WindZone -600 -600 -50 600 600 300 0.5 0.2 0.0 0.3 0.1

# ==============================================================================
# GLOBAL LIGHTING
# Cold overcast directional sun plus a warm fill from the opposite side.
# ==============================================================================
light directional 300 -200 400 180 210 230 1.0
light directional -100 200 100 120 130 150 0.25

# ==============================================================================
# ADDITIONAL LOCAL LIGHTS
# Warm pools at industrial areas so structures read through the fog.
# ==============================================================================
# Fuel farm
light point 120 345 10 255 150 70 0.7 35 2
# Hangar approach
light point -140 290 6 220 200 170 0.6 25
# Refinery gate
light point 0 -26 8 255 140 60 0.8 25 2
# Rail terminal loading bay
light point 295 -45 6 200 200 200 0.6 20
# Security outpost gate
light point 335 -60 6 255 200 170 0.6 20
# South artery lamp
light point 0 -365 8 220 220 230 0.5 30
# Data console lobby entrance
light point 0 -380 6 200 210 255 0.6 18

# ==============================================================================
# PLAYER START
# Exactly one playerstart is used by the engine. Placed in Z10 Data Console
# Lobby on the concrete pad, facing the refinery to the north.
#
# yaw is compass-style: RespawnPlayerAtStart() builds the camera target as
# (x + sin(yaw), y, z - cos(yaw)), so yaw=0 looks toward -Y (SOUTH) and
# yaw=180 looks toward +Y (NORTH). The lobby's only opening is its north face
# at y=-375, so the spawn must use 180 to face the refinery. Using 0 spawns
# the player staring at the lobby's 35u back wall.
# ==============================================================================
playerstart 0 -410 0.1 180

# ==============================================================================
# NPCs
# Small patrol groups so the world is not inert.
# ==============================================================================
npc Walker -140 320 0.1
npc Brute -64 51 0.1
npc Skaarj 262 95 0.1
npc Walker 335 0 0.1

# ==============================================================================
# NPC PATH NODES
# Patrol graphs linked by name.
# ==============================================================================
PathNode hangar_patrol_a -180 320 0.1 radius=3 next=hangar_patrol_b
PathNode hangar_patrol_b -100 360 0.1 radius=3 next=hangar_patrol_a
PathNode refinery_patrol_a -64 0 0.1 radius=4 next=refinery_patrol_b
PathNode refinery_patrol_b 64 100 0.1 radius=4 next=refinery_patrol_a
PathNode power_patrol_a 230 130 0.1 radius=4 next=power_patrol_b
PathNode power_patrol_b 290 30 0.1 radius=4 next=power_patrol_a
PathNode security_patrol_a 335 -40 0.1 radius=3 next=security_patrol_b
PathNode security_patrol_b 335 40 0.1 radius=3 next=security_patrol_a

# ==============================================================================
# PICKUPS
# Weapons, health, and supplies placed at logical points.
