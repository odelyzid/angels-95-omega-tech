Mesh.Static Models/rocks/SM_RP_Rock_4m_1.glb -460 -150 0 200 scale=1.0 tex=oztex/props/rocks_T_RP_Rocks_2_2K.png
Mesh.Static Models/rocks/SM_RP_Rock_4m_2.glb -475 -380 0 310 scale=1.0 tex=oztex/props/rocks_T_RP_Rocks_0_2K.png
# Right-edge cliff massing
Mesh.Static Models/rocks/SM_RP_Rock_8m_3.glb 500 250 0 -60 scale=1.2 tex=oztex/props/rocks_T_RP_Rocks_0_4K.png
