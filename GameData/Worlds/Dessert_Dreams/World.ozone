OZONE
# Dessert_Dreams - Sun-baked desert oasis at midday.
# OZONE Z-up: x=east, y=north, z=up.
#
# Authoring notes for this file:
#   * Ground level is z=0 everywhere OUTSIDE the dais. The dais top is z=2 and
#     the oasis basin floor is z=-2. The previous revision had its ground plane
#     topping out at z=-1 while every entity sat at z>=0, so the whole level
#     floated a unit above the sand.
#   * `box <cx> <cy> <cz> <w> <h> <d> <rot>` is CENTRE-based; h is the Z extent.
#   * `cyl <cx> <cy> <cz> <rTop> <rBot> <h> <slices> <rot>` spans z = [cz-h, cz]:
#     the authored cz is the TOP of a cylinder, not its centre.
#   * Ceilings are placed with their underside at 4.0+ so a 3-tall player fits.
#   * Every zone carries an explicit name=. Auto-generated names ("zone_sky_0")
#     collide between worlds and made this map run another world's script.
#
# Layout (player arrives from the west through the ruined gate):
#
#      Mesa (N)            ruined outpost (SE)
#         ^                        ^
#   ~~~~~ | ~~~~~~~~~~~~~~~~~~~~~~~~ | ~~~~~~~~~~
#        [ ruined gateway ]         [ colonnade ]
#   ---- [ W step ][ RAISED DAIS z=2 ] ----------
#              [ OASIS basin z=-2 ]            -> E ruins
#   ~~~~~ backdrop cliffs at +/-100 ~~~~~~~~~~~~~

# ==============================================================================
# Ground. Top face is z=0.
# ==============================================================================
add box 0 0 -0.5 210 1 210 0 texPath=oztex/xtSand.png texScaleU=24 texScaleV=24

# ==============================================================================
# Painted cliff backdrop (SURF_FAKEBACKDROP, flags=8). Drawn unlit at full
# painted value and skipped by the lit geometry pass, so it reads as distant
# scenery rather than a wall the sun has to hit. Also the map's collision edge.
#
# Heights deliberately alternate and are tall (84-104) so the skyline is broken
# AND reads as canyon wall rather than a courtyard parapet. Low tex repeats keep
# the rock strata large - at texScale 5 the 64px tile turned into brickwork.
add box -75 100 26 50 52 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box -25 100 22 50 44 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box 25 100 29 50 58 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box 75 100 24 50 48 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box -75 -100 26 50 52 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box -25 -100 22 50 44 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box 25 -100 29 50 58 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box 75 -100 24 50 48 1 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box 100 -75 26 1 52 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box 100 -25 22 1 44 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box 100 25 29 1 58 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box 100 75 24 1 48 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box -100 -75 26 1 52 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box -100 -25 22 1 44 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box -100 25 29 1 58 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=3
add box -100 75 24 1 48 50 0 flags=8 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2


# ==============================================================================
# Distant mesa - the one large silhouette on the horizon, north of the dais.
# Stepped so it reads as eroded rock rather than a single extruded box.
# ==============================================================================
add box -18 74 7 34 14 18 0 texPath=oztex/xtCliff.png texScaleU=8 texScaleV=4
add box -20 74 17 22 6 12 0 texPath=oztex/xtCliff.png texScaleU=6 texScaleV=3
add box -22 74 23 12 6 7 0 texPath=oztex/xtCliff.png texScaleU=5 texScaleV=2
add cyl -8 70 26 3 3 6 16 0 texPath=oztex/xtCliff.png texScaleU=3 texScaleV=3
add cyl -30 80 20 2.5 2.5 4 16 0 texPath=oztex/xtCliff.png texScaleU=3 texScaleV=3

# ==============================================================================
# Raised dais, top z=2. Built as four slabs AROUND the basin rather than one
# slab with a hole: `sub` carves collision only, never the render mesh, so a
# subtracted pit would be an invisible hole the player falls into.
# Basin opening is x -8..8, y -8..8.
# ==============================================================================
add box 0 15 1 44 2 14 0 1
add box 0 -15 1 44 2 14 0 1
add box -15 0 1 14 2 16 0 1
add box 15 0 1 14 2 16 0 1

# Basin floor (z -2..-1) and its four inner walls, so the pit is a real volume.
add box 0 0 -1.5 16 1 16 0 texPath=oztex/xtCoal.png texScaleU=4 texScaleV=4
add box 0 8.5 0.5 17 3 1 0 3
add box 0 -8.5 0.5 17 3 1 0 3
add box 8.5 0 0.5 1 3 16 0 3
add box -8.5 0 0.5 1 3 16 0 3
# Coping stones around the lip
add box 0 9 2.3 20 0.6 2 0 2
add box 0 -9 2.3 20 0.6 2 0 2
add box 9 0 2.3 2 0.6 18 0 2
add box -9 0 2.3 2 0.6 18 0 2

# West approach steps: sand 0 -> tread 1.0 -> dais 2.0. Each rise is exactly
# kStepHeight (1.0) so they are walked, not jumped.
add box -23.5 0 0.5 3 1 12 0 1
add box -21.5 -9 0.5 3 1 6 0 1
add box -21.5 9 0.5 3 1 6 0 1
# Matching steps on the east side so the dais is not a one-way ledge
add box 23.5 0 0.5 3 1 12 0 1
add box 21.5 -9 0.5 3 1 6 0 1
add box 21.5 9 0.5 3 1 6 0 1

# ==============================================================================
# Colonnade on the dais. Six columns carrying two roof slabs, so the player
# walks through real shade. Columns span z 2..8 (cyl z range is [cz-h, cz]).
# The old revision ringed the spawn with eight knee-high posts textured with
# the game's own title-screen logo.
# ==============================================================================
add cyl -18 -18 8 0.9 0.9 6 16 0 3
add cyl 18 -18 8 0.9 0.9 6 16 0 3
add cyl -18 18 8 0.9 0.9 6 16 0 3
add cyl 18 18 8 0.9 0.9 6 16 0 3
add cyl 0 -18 8 0.9 0.9 6 16 0 3
add cyl 0 18 8 0.9 0.9 6 16 0 3
# Roof slabs over the west and south colonnades (underside z=8.0)
add box -9 -18 8.3 20 0.6 6 0 4
add box -18 0 8.3 6 0.6 20 0 4
# Architrave on the two open sides so the colonnade reads as a ruin, not scaffolding
add box 9 -18 8.6 20 1.2 2 0 2
add box 18 0 8.6 2 1.2 20 0 2
# Plinths under each column
add box -18 -18 2.3 4 0.6 4 0 2
add box 18 -18 2.3 4 0.6 4 0 2
add box -18 18 2.3 4 0.6 4 0 2
add box 18 18 2.3 4 0.6 4 0 2

# ==============================================================================
# Ruined gateway on the west approach - the landmark the spawn faces. Asymmetric
# (the north pier is broken off and the lintel only survives over the south half)
# so it reads as a ruin rather than a clean arch.
# ==============================================================================
add box -42 -7 4 6 8 6 0 3
add box -42 7 3 6 6 6 0 3
add box -42 -5 9 6 2 12 0 3
add box -42 7 7.5 6 1 10 0 3
add box -42 -7 8.3 8 0.6 8 0 2
add box -42 7 6.3 8 0.6 8 0 2
# Rubble at the base of the broken pier
add box -38 5 0.6 4 1.2 5 0 3
add box -46 4 0.4 3 0.8 3 0 3

# ==============================================================================
# Ruined outpost, south-east. Wall openings are built as separate segments
# (pier / pier / lintel) rather than `sub`, because `sub` does not cut the
# render mesh.
# ==============================================================================
add box 52 -46 3 3 6 22 0 2
add box 52 -30 3 3 6 6 0 2
add box 52 -56 7 3 2 8 0 2
add box 40 -46 3 22 6 3 0 2
add box 52 -34 6.3 8 0.6 8 0 4
# Interior cover
add box 46 -50 1 3 2 3 0 texPath=oztex/xtMetalRusty.png texScaleU=2 texScaleV=2
add box 56 -52 1.5 3 3 3 0 texPath=oztex/xtMetalRusty.png texScaleU=2 texScaleV=2
add cyl 48 -40 4 1.2 1.2 4 16 0 texPath=oztex/xtMetalRusty.png texScaleU=2 texScaleV=2

# ==============================================================================
# Cover scatter and boulders. All tops are at floor+1.5 or more so they still
# block - anything within kStepHeight (1.0) of the feet is walked over.
# ==============================================================================
add box -60 -18 1.5 6 3 6 0 texPath=oztex/xtCliff.png texScaleU=3 texScaleV=2
add box -64 -14 1 4 2 4 0 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add cyl -52 -30 4 2.2 2.2 4 16 0 texPath=oztex/xtCliff.png texScaleU=3 texScaleV=3
add cyl -34 -34 3 1.6 1.6 3 16 0 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add cyl 34 26 4 2 2 4 16 0 texPath=oztex/xtCliff.png texScaleU=3 texScaleV=3
add box 30 34 1.5 7 3 5 0 texPath=oztex/xtCliff.png texScaleU=3 texScaleV=2
add cyl 62 12 5 2.4 2.4 5 16 0 texPath=oztex/xtCliff.png texScaleU=3 texScaleV=3
add cyl 70 6 3 1.5 1.5 3 16 0 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
add box -70 8 1.5 5 3 5 0 texPath=oztex/xtMetalRusty.png texScaleU=2 texScaleV=2
add cyl -80 16 4 1.8 1.8 4 16 0 texPath=oztex/xtCliff.png texScaleU=2 texScaleV=2
# Cactus stands
add cyl 44 44 6 1 1 6 16 0 texPath=oztex/xtCactus.png texScaleU=2 texScaleV=3
add cyl 50 38 5 0.8 0.8 5 16 0 texPath=oztex/xtCactus.png texScaleU=2 texScaleV=3
add cyl 40 50 4 0.7 0.7 4 16 0 texPath=oztex/xtCactus.png texScaleU=2 texScaleV=2
add cyl -66 40 5 0.9 0.9 5 16 0 texPath=oztex/xtCactus.png texScaleU=2 texScaleV=3
add cyl -72 46 4 0.8 0.8 4 16 0 texPath=oztex/xtCactus.png texScaleU=2 texScaleV=2

# ==============================================================================
# Entities
# ==============================================================================
# Only playerstart #1 is ever used (PawnSystem::GetFirstPlayerStart), so this one
# line decides the first frame: broken gateway ~28u dead ahead filling the middle
# of the frame, the lit colonnade and dais beyond it, mesa on the skyline.
playerstart -72 0 0 80

# --- Pickups (all on a real surface, none inside a brush) ---
pickup HealthVial -78 2 1 30
pickup ManaVial -74 8 1 30
pickup pistol_01 -60 0 1 30
pickup Key -84 -6 1 30
pickup Coin -66 12 1 30
# Dais
pickup HealthVial 0 14 3 30
pickup ManaVial -14 0 3 30
pickup EnergyCrystal 0 -14 3 30
pickup Medkit 14 14 3 30
# Colonnade shade
pickup pistol_01 -18 0 3 30
pickup ManaTonic 18 0 3 30
# Outpost and east approach
pickup rifle_01 52 -46 3 30
pickup Powerup 52 -56 3 30
pickup Key 66 8 1 30
pickup EnergyCrystal -18 62 1 30
# Basin floor
pickup ManaVial 0 0 -0.5 30

# ==============================================================================
# NPC patrol graphs. Links are by NAME so the graph survives editor reordering.
# ==============================================================================
PathNode gate_out -55 0 1 radius=4 next=gate_in
PathNode gate_in -36 0 3 radius=3 next=plaza_w
PathNode plaza_w -18 0 3 radius=3 next=plaza_n,plaza_s
PathNode plaza_n 0 16 3 radius=3 next=plaza_e,plaza_w
PathNode plaza_e 18 0 3 radius=3 next=plaza_s,plaza_n
PathNode plaza_s 0 -16 3 radius=3 next=plaza_w,plaza_e
PathNode rim_n 0 11 2 radius=2.5 next=rim_e,basin
PathNode rim_e 11 0 2 radius=2.5 next=rim_s,basin
PathNode rim_s 0 -11 2 radius=2.5 next=rim_w,basin
PathNode rim_w -11 0 2 radius=2.5 next=rim_n,basin
PathNode basin 0 0 -1.5 radius=2 next=rim_n
PathNode mesa_foot -20 58 1 radius=5 next=mesa_top
PathNode mesa_top -20 66 1 radius=5 next=mesa_foot
PathNode outpost_a 46 -40 1 radius=3 next=outpost_b
PathNode outpost_b 58 -50 1 radius=3 next=outpost_a

npc Walker -55 0 1
npc Walker -36 0 3
npc Skaarj 0 16 3
npc Skaarj 18 0 3
npc Brute -18 0 3
npc Floater 0 11 2
npc Walker -20 58 1
npc Brute 46 -40 1
npc Walker 30 26 1
npc Floater -60 -18 1

# ==============================================================================
# Lights
# ==============================================================================
# High midday sun. The authored point is the light SOURCE, aimed at the world
# origin, so a large z puts the sun overhead and a negative x/y rakes it from
# the west. Weak opposing fill keeps shadowed faces readable.
light directional -60 -50 110 255 250 235 1.15
light directional 60 50 40 150 175 205 0.28
# Oasis: warm bounce off the basin walls, cool sky reflection in the pit
light point 0 0 0 120 180 220 0.55 26
# Warm lamps under the colonnade roof
light point -18 -18 6 255 205 150 0.7 18
light point -18 18 6 255 205 150 0.7 18
light point 18 18 6 255 205 150 0.7 18
# Gate lanterns
light point -42 -7 6 255 190 120 0.6 14
light point -42 7 5 255 190 120 0.6 14
# Outpost brazier + mesa bounce
light point 52 -50 5 255 170 90 0.7 20
light point -18 68 14 255 220 170 0.5 30
# Approach
light point -70 0 5 255 235 200 0.5 30
light point 60 10 5 255 235 200 0.4 25

# ==============================================================================
# Zones
# ==============================================================================
zone sky -120 -120 -30 120 120 90 1 name=dd_sky
# The oasis pool actually fills the basin. The previous revision put the water
# volume at z 0..2 over DRY SAND one to three units above the ground, so simply
# walking across the plaza halved gravity and killed the jump with no water in
# sight.
zone water -8 -8 -2 8 8 -0.3 1 name=dd_oasis

# Bright clear desert sky: blue overhead, paler blue at the horizon.
levelinfo 0 8 5 0 10 50 0 GameData/Global/sky/sky_noon.dds GameData/Global/sky/sky_day.dds

