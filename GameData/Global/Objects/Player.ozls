entity "Player" : upgrade {
    // Player character model used to render players in the world.
    // Plague Arcanist: rigged GLB with its own embedded textures, so `texture` is
    // omitted (PlayerModel only falls back to the legacy PNG for the default mesh).
    // mesh_type is static on purpose - the GLB's 10 clips are unnamed mixamo takes
    // whose semantics are unknown, and guessing an idle/walk mapping would leave
    // the character playing an arbitrary animation. Rename the clips (editor
    // Anim panel) and set anim_idle / anim_chase here to switch it to skeletal.
    mesh = "GameData/Global/Player/Plague_Arcanist.glb"
    mesh_type = "static"
    // Base walk-speed multiplier (sprint/crouch scale this at runtime).
    movement_speed = 1.4
    stats {
        health = 100
        max_health = 100
        mana = 0
        max_mana = 100
        psychic_energy = 0
        max_psychic_energy = 100
        level = 1
        xp = 0
        xp_to_next = 100
    }
}
